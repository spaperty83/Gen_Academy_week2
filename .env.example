# Copy this template to .env and configure credentials locally.
# Never commit API keys. Existing environment variables override .env values.
OPENAI_API_KEY=

# Chat model must support native JSON-schema structured output.
CHAT_MODEL=gpt-4.1-mini

# Re-ingest after changing embedding settings.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536


# Number of retrieved passages (1 through 20).
TOP_K=5

# Chunk size and overlap are measured in characters, not tokens.
CHUNK_SIZE=1800
CHUNK_OVERLAP=250

# Dense vectors are stored and searched in Pinecone.
PINECONE_API_KEY=
PINECONE_INDEX=national-parks-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
